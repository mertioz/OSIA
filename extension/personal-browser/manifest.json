{
  "manifest_version": 3,
  "name": "OSIA Personal Browser",
  "version": "1.0.0",
  "description": "Explicitly authorize one tab for one OSIA Personal Browser turn.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "incognito": "not_allowed",
  "action": {
    "default_title": "Authorize this tab for OSIA"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  }
}
