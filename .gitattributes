# Windows batch files MUST use CRLF — cmd.exe misparses multi-line if/else and
# goto/label blocks in bare-LF .bat files. Force CRLF on checkout (WOR-11).
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Keep Unix-style scripts and Python as LF on all platforms.
*.sh        text eol=lf
*.py        text eol=lf

# Canonical Guide artifacts are hashed across the PC and Mobile repositories.
assets/guide/catalog.v4.json text eol=lf

# The site checks the generated legal artifacts byte for byte.
osia/legal_documents/legal-manifest.json text eol=lf

# Exact upstream bytes are verified before bundling, including on Windows.
packaging/windows/licenses/codex/LICENSE text eol=lf
packaging/windows/licenses/codex/NOTICE text eol=lf

# Treat binaries as binary (no EOL/CRLF munging, no diff).
*.wav       binary
*.pkl       binary
*.png       binary
*.exe       binary
