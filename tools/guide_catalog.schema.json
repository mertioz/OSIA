{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osia.space/schemas/guide-catalog-v4.json",
  "title": "OSIA Guide catalog v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "tracks"],
  "properties": {
    "schema_version": {"const": 4},
    "content_version": {"type": "integer", "minimum": 4},
    "tracks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/track"}
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "fr"],
      "properties": {
        "en": {"type": "string", "minLength": 1},
        "fr": {"type": "string", "minLength": 1}
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "body"],
      "properties": {
        "kind": {"enum": ["example", "remember", "safety"]},
        "title": {"$ref": "#/$defs/localized"},
        "body": {"$ref": "#/$defs/localized"}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "alt"],
      "properties": {
        "kind": {"enum": ["native", "diagram", "callout", "screenshot"]},
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "alt": {"$ref": "#/$defs/localized"},
        "asset": {"type": "string", "minLength": 1}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {"const": "none"},
        "target": {"const": ""}
      }
    },
    "slideVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {"$ref": "#/$defs/localized"},
        "subtitle": {"$ref": "#/$defs/localized"},
        "body_blocks": {
          "type": "array",
          "items": {"$ref": "#/$defs/localized"}
        },
        "callouts": {
          "type": "array",
          "items": {"$ref": "#/$defs/callout"}
        },
        "visual": {"$ref": "#/$defs/visual"}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slide_id", "track_id", "order", "title", "subtitle",
        "body_blocks", "callouts", "visual", "action", "legacy_ids"
      ],
      "properties": {
        "slide_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "track_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "order": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/localized"},
        "subtitle": {"$ref": "#/$defs/localized"},
        "body_blocks": {
          "type": "array",
          "items": {"$ref": "#/$defs/localized"}
        },
        "callouts": {
          "type": "array",
          "items": {"$ref": "#/$defs/callout"}
        },
        "visual": {"$ref": "#/$defs/visual"},
        "action": {"$ref": "#/$defs/action"},
        "legacy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "platform_variants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pc": {"$ref": "#/$defs/slideVariant"},
            "mobile": {"$ref": "#/$defs/slideVariant"}
          }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "semantic_id", "order", "title", "summary", "slides"],
      "properties": {
        "track_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "semantic_id": {"enum": ["essential", "mastery", "advanced"]},
        "order": {"type": "integer", "minimum": 1, "maximum": 3},
        "title": {"$ref": "#/$defs/localized"},
        "summary": {"$ref": "#/$defs/localized"},
        "slides": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/slide"}
        }
      }
    }
  }
}
